// Sellora — PostgreSQL schema via Prisma
// Multi-tenant: every tenant-owned table is scoped by `businessId`.
// Use a relational database (Neon PostgreSQL). Do NOT use SQLite in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum InstagramConnectionStatus {
  CONNECTED
  DEGRADED
  REAUTH_REQUIRED
  DISCONNECTED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  locale        String   @default("fa")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships BusinessMember[]

  @@index([email])
}

model Business {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  locale      String   @default("fa")
  currency    String   @default("IRR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members    BusinessMember[]
  instagram  InstagramAccount?
  posts      InstagramPost[]
  products   Product[]
  variants   ProductVariant[]
  rules      BusinessRule[]
  rulesets   BusinessRuleset[]
  automation AutomationConfig?
  convos     Conversation[]
  messages   Message[]
  leads      Lead[]
  webhooks   WebhookEvent[]
  jobs       FailedJob[]
  audit      AuditLog[]
  subscription Subscription?
  usage      UsageSnapshot[]
  notifications Notification[]
}

model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       UserRole @default(OWNER)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Instagram
// ---------------------------------------------------------------------------

model InstagramAccount {
  id                 String                    @id @default(cuid())
  businessId         String                    @unique
  instagramBusinessAccountId String             @unique // IGSID / page-scoped ID
  pageId             String?
  username           String?
  name               String?
  profilePicUrl      String?
  accessToken        String // encrypted at rest by app layer (see lib/crypto)
  tokenExpiresAt     DateTime?
  status             InstagramConnectionStatus @default(DISCONNECTED)
  lastVerifiedAt     DateTime?
  scope              String?
  metaAppId          String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  posts         InstagramPost[]
  conversations Conversation[]

  @@index([status])
}

model InstagramPost {
  id           String   @id @default(cuid())
  businessId   String
  igAccountId  String
  igMediaId    String   @unique
  mediaType    String?
  permalink    String?
  caption      String?
  thumbnailUrl String?
  mediaUrl     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  igAccount InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum ProductStatus {
  AVAILABLE
  UNAVAILABLE
  ARCHIVED
}

model Product {
  id          String        @id @default(cuid())
  businessId  String
  name        String
  description String?
  sku         String?
  price       Int           // in smallest currency unit (for IRR: rials; toman = price/10)
  imageUrl    String?
  status      ProductStatus @default(AVAILABLE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variants ProductVariant[]
  contexts ConversationContext[]

  @@unique([businessId, sku])
  @@index([businessId, status])
  @@index([businessId, name])
}

model ProductVariant {
  id         String        @id @default(cuid())
  businessId String
  productId  String
  size       String?
  color      String?
  sku        String?
  price      Int?          // override
  status     ProductStatus @default(AVAILABLE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  contexts ConversationContext[]

  @@unique([businessId, sku])
  @@index([productId])
  @@index([businessId, status])
}

// ---------------------------------------------------------------------------
// Business rules
// ---------------------------------------------------------------------------

model BusinessRuleset {
  id         String   @id @default(cuid())
  businessId String
  version    Int      @default(1)
  isActive   Boolean  @default(true)
  address    String?
  phone      String?
  workingHours Json?   // { sat: {open:"09:00",close:"21:00"}, ... }
  shippingInfo String?
  paymentMethods String?
  returnPolicy String?
  generalInfo  String?
  citiesServed String?
  notes        String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, isActive])
}

model BusinessRule {
  id         String   @id @default(cuid())
  businessId String
  key        String   // e.g. "shipping", "payment", "hours", "custom"
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@index([businessId])
}

// ---------------------------------------------------------------------------
// Automation (internal — owner UI hides complexity)
// ---------------------------------------------------------------------------

model AutomationConfig {
  id              String   @id @default(cuid())
  businessId      String   @unique
  enabled         Boolean  @default(false)
  autoReplyComments Boolean @default(false)
  defaultTone     String   @default("friendly")
  useAiFallback   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Conversations
// ---------------------------------------------------------------------------

enum ConversationState {
  NEW
  ACTIVE
  WAITING_CUSTOMER
  WAITING_OWNER
  OWNER_ACTIVE
  QUALIFIED
  COMPLETED
  EXPIRED
}

enum AutomationLock {
  AUTO
  HUMAN
}

model Conversation {
  id            String            @id @default(cuid())
  businessId    String
  igAccountId   String
  igSid         String            // Instagram-scoped user id (customer)
  customerName  String?
  customerUsername String?
  customerProfilePic String?
  postId        String?           // originating post if started from comment
  state         ConversationState @default(NEW)
  automationLock AutomationLock   @default(AUTO)
  lastMessageAt  DateTime         @default(now())
  contextExpiresAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  igAccount InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  messages  Message[]
  context   ConversationContext?
  lead      Lead?

  @@unique([businessId, igAccountId, igSid])
  @@index([businessId, state])
  @@index([businessId, lastMessageAt])
  @@index([businessId, automationLock])
}

model ConversationContext {
  id              String   @id @default(cuid())
  conversationId  String   @unique
  activeProductId String?
  activeVariantId String?
  activeIntent    String?
  city            String?
  customerContact String?
  entitiesJson    Json     @default("{}")
  lastProductMentionedAt DateTime?
  updatedAt       DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [activeProductId], references: [id])
  variant      ProductVariant? @relation(fields: [activeVariantId], references: [id])
}

// ---------------------------------------------------------------------------
// Messages
// ---------------------------------------------------------------------------

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSenderType {
  CUSTOMER
  SELLORA
  OWNER
  SYSTEM
}

enum DeliveryState {
  PENDING
  SENDING
  SENT
  FAILED
  RETRYING
  EXPIRED
  BLOCKED
}

model Message {
  id             String           @id @default(cuid())
  businessId     String
  conversationId String
  igMessageId    String?          // Meta message ID (outbound or inbound)
  direction      MessageDirection
  senderType     MessageSenderType
  text           String           @db.Text
  metadataJson   Json?            // attachments, intents, entities, template used
  deliveryState  DeliveryState    @default(PENDING)
  failureReason  String?
  deliveredAt    DateTime?
  seenAt         DateTime?
  idempotencyKey String?          // unique per outbound send attempt
  createdAt      DateTime         @default(now())

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  deliveries   MessageDelivery[]

  @@index([businessId, createdAt])
  @@index([conversationId, createdAt])
  @@index([deliveryState])
}

model MessageDelivery {
  id             String        @id @default(cuid())
  messageId      String
  attempt        Int           @default(0)
  requestMeta    Json?
  responseMeta   Json?
  deliveryState  DeliveryState
  errorCode      String?
  errorMessage   String?
  attemptedAt    DateTime      @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

enum LeadTemperature {
  COLD
  WARM
  HOT
}

model Lead {
  id              String          @id @default(cuid())
  businessId      String
  conversationId  String          @unique
  temperature     LeadTemperature @default(COLD)
  score           Int             @default(0) // 0-100
  reason          String?         // primary reason (persian text for UI)
  signalsJson     Json            @default("[]") // structured signals
  relevantIntent  String?
  contactName     String?
  contactPhone    String?
  contactCity     String?
  capturedContact Boolean         @default(false)
  hotAt           DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([businessId, temperature])
  @@index([businessId, score])
  @@index([businessId, createdAt])
}

// ---------------------------------------------------------------------------
// Webhooks, jobs, audit
// ---------------------------------------------------------------------------

model WebhookEvent {
  id           String   @id @default(cuid())
  businessId   String?  // can be null until we resolve account
  source       String   @default("meta") // "meta", "qstash", ...
  externalId   String?  // Meta entry/message id for idempotency
  eventType    String   // e.g. "messages","comments","messaging_postbacks"
  signatureOk  Boolean  @default(false)
  payload      Json
  processed    Boolean  @default(false)
  processingError String?
  receivedAt   DateTime @default(now())
  processedAt  DateTime?

  business Business? @relation(fields: [businessId], references: [id])

  @@unique([source, externalId])
  @@index([processed])
  @@index([receivedAt])
}

model FailedJob {
  id          String   @id @default(cuid())
  businessId  String?
  jobType     String
  payload     Json
  error       String
  attempts    Int      @default(0)
  lastErrorAt DateTime @default(now())
  createdAt   DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id])

  @@index([jobType])
}

model AuditLog {
  id          String   @id @default(cuid())
  businessId  String
  actorUserId String?
  action      String   // "product.create", "product.price_change", "instagram.connect", ...
  targetType  String?
  targetId    String?
  metaJson    Json?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Subscription / usage / notifications
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELED
}

model Subscription {
  id         String             @id @default(cuid())
  businessId String             @unique
  plan       SubscriptionPlan
  status     SubscriptionStatus @default(TRIAL)
  amount     Int                // amount paid (in toman or rials — see currency)
  currency   String             @default("IRR")
  startsAt   DateTime           @default(now())
  endsAt     DateTime?
  refId      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model UsageSnapshot {
  id         String   @id @default(cuid())
  businessId String
  date       DateTime @db.Date
  inbound    Int      @default(0)
  outbound   Int      @default(0)
  resolvedAuto Int    @default(0)
  hotLeads   Int      @default(0)
  ownerTakeovers Int  @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
}

model Notification {
  id         String   @id @default(cuid())
  businessId String
  kind       String   // "lead.hot", "instagram.reauth", "system"...
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, readAt])
}
