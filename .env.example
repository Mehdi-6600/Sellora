# ---------------------------------------------------------------------------
# Sellora — environment variables
#
# Copy this file to `.env` for local development. On Vercel set all values as
# project-level environment variables (Production + Preview + Development
# environments as appropriate). NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Database (Neon PostgreSQL required) -----------------------------------
# Pooled connection string (used at runtime by Prisma Client). Append
# ?pgbouncer=true&sslmode=require for Neon pooled endpoints.
DATABASE_URL="postgresql://user:password@ep-xxxxxx-pooler.us-east-2.aws.neon.tech/sellora?sslmode=require"
# Direct (non-pooled) connection string. Prisma migrate deploy uses this.
DIRECT_URL="postgresql://user:password@ep-xxxxxx.us-east-2.aws.neon.tech/sellora?sslmode=require"

# --- App -------------------------------------------------------------------
# Long random secret used to sign session JWTs. Generate with:
#   openssl rand -base64 48
NEXTAUTH_SECRET="generate-a-strong-random-secret-here"
# 32-byte base64url key for AES-256-GCM encryption of Instagram tokens.
# Generate with:  openssl rand -base64 32  | tr '+/' '-_' | tr -d '='
DATA_ENCRYPTION_KEY=""
# Public base URL of the deployment (used for OAuth redirects + QStash callback).
APP_URL="https://your-app.vercel.app"

# --- Meta / Instagram (Graph API) -----------------------------------------
META_APP_ID=""
META_APP_SECRET=""
# Graph API version — bump when Meta releases a new version (e.g. "v22.0").
META_API_VERSION="v21.0"
# Random token you set in the Meta App Dashboard's Webhooks panel.
META_WEBHOOK_VERIFY_TOKEN=""
# OAuth redirect URI; must exactly match one of the URIs whitelisted in the
# Meta App Dashboard. Defaults to APP_URL + /api/instagram/callback if unset.
META_REDIRECT_URI=""
# Override for Graph base URL (rarely needed). Defaults to https://graph.facebook.com
# META_GRAPH_BASE_URL="https://graph.facebook.com"
# Optional: comma-separated additional app secrets (for multi-app deployments).
# META_APP_SECRETS=""

# --- Queue (Upstash QStash) — optional but recommended for production -------
# Without QSTASH_TOKEN Sellora processes background jobs synchronously inside
# the request (best-effort, no retries). Set these to get durable delivery.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# --- AI (optional) ---------------------------------------------------------
# When set AND business automation has useAiFallback=true, LOW/UNKNOWN intents
# may consult OpenAI. The AI is forbidden from inventing prices, availability,
# shipping, hours, address, or policy — DB/business rules always win.
OPENAI_API_KEY=""
AI_ENABLED="false"
